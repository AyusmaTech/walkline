# Optional legacy Google provider only: server key restricted to Geocoding/Routes.
# The default OpenStreetMap provider does not need this key. Never put it in Android.
GOOGLE_MAPS_SERVER_KEY=
# Private pilot token. Use the same value as NAV_API_TOKEN in Android local.properties.
# This is a pilot access gate, not production user authentication.
NAV_API_TOKEN=
HOST=127.0.0.1
PORT=8080
# OpenStreetMap data is used by the custom 3D renderer. Google is an explicit legacy option.
NAV_DATA_PROVIDER=openstreetmap
# Community endpoints are for a small local pilot, throttled to <=1 request/second/host.
# Configure your own/hosted endpoints before general distribution.
PHOTON_BASE_URL=https://photon.komoot.io
OSRM_FOOT_BASE_URL=https://routing.openstreetmap.de/routed-foot
